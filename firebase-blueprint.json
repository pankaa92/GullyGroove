  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile document containing display name, email, photo URL, and timestamps."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "Owner-only user theme, crossfade, DJ mode, and notification preferences."
    },
    "/users/{userId}/personalPlaylists/{playlistId}": {
      "schema": { "$ref": "#/entities/PersonalPlaylist" },
      "description": "Private personal playlists owned by the user."
    },
    "/users/{userId}/personalPlaylists/{playlistId}/tracks/{trackId}": {
      "schema": { "$ref": "#/entities/PersonalPlaylistTrack" },
      "description": "Tracks saved inside a user's private personal playlist."
    },
    "/users/{userId}/likedSongs/{trackId}": {
      "schema": { "$ref": "#/entities/LikedSong" },
      "description": "Private liked/hearted songs for the authenticated user."
    },
    "/users/{userId}/recentlyPlayed/{trackId}": {
      "schema": { "$ref": "#/entities/RecentlyPlayedTrack" },
      "description": "Private recently played history for the authenticated user."
    },
    "/sharedPlaylists/{playlistId}": {
      "schema": { "$ref": "#/entities/SharedPlaylist" },
      "description": "Shared community/curated playlists readable by all users and configurable by owners."
    },
    "/sharedPlaylists/{playlistId}/sharedTracks/{trackId}": {
      "schema": { "$ref": "#/entities/SharedPlaylistTrack" },
      "description": "Tracks contributed to shared playlists with contributor metadata."
    },
    "/sharedPlaylists/{playlistId}/contributors/{contributorUid}": {
      "schema": { "$ref": "#/entities/PlaylistContributor" },
      "description": "Contributor tracking per shared playlist."
    }
  }
}
