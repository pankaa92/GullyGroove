{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated GullyGroove user profile isolated to the owning Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name from Google Sign-In",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address (PII, owner-only)",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "Profile photo URL",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Per-user playback, theme, crossfade, and notification preferences.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "maxLength": 16
        },
        "crossfadeSec": {
          "type": "number"
        },
        "djCrossfadeSec": {
          "type": "number"
        },
        "djMode": {
          "type": "boolean"
        },
        "nowPlayingAlerts": {
          "type": "boolean"
        },
        "curatedPlaylistDrops": {
          "type": "boolean"
        },
        "groovyVoiceTips": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "theme",
        "crossfadeSec",
        "djCrossfadeSec",
        "djMode",
        "nowPlayingAlerts",
        "curatedPlaylistDrops",
        "groovyVoiceTips",
        "updatedAt"
      ]
    },
    "PersonalPlaylist": {
