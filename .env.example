# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Modular Music Discovery Provider Credentials (Server-side only)
# YouTube Data API v3 (Metadata & official embed discovery; respects YouTube playback policies)
YOUTUBE_API_KEY=""

# Jamendo API (Creative Commons licensed independent artist streaming)
JAMENDO_CLIENT_ID=""
